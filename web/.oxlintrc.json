{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "@testing-library/jest-dom/vitest"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "fetch", "message": "Use request() from ./http. It gives up after a time limit." }
        ]
      }
    },
    {
      "files": ["src/http.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
      "rules": { "no-restricted-globals": "off" }
    }
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
